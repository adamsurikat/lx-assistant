# Copy this file to .env.local and fill in real values. Never commit .env.local.


# NextAuth
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# Used to encrypt Jira OAuth tokens before storing them in SQLite (AES-256-GCM key, 32 bytes base64)
TOKEN_ENCRYPTION_KEY="generate-with: openssl rand -base64 32"

# Jira OAuth 2.0 (3LO) app, used to connect a user's Jira Cloud site.
# Register one at https://developer.atlassian.com/console/myapps/
# Callback URL: https://{YOUR_DOMAIN}/api/jira/callback
JIRA_OAUTH_CLIENT_ID="your-atlassian-oauth-client-id"
JIRA_OAUTH_CLIENT_SECRET="your-atlassian-oauth-client-secret"
