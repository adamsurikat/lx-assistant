generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- NextAuth required models (Prisma adapter) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Jira integration fields (API token connection method — the default/
  // simple option; see also JiraConnection for the optional OAuth method)
  jiraEmail          String? // Atlassian account email used for API auth
  jiraApiTokenCipher String? // Encrypted Jira API token (AES-256-GCM, see lib/crypto.ts)
  jiraSiteUrl        String? // e.g. https://yourcompany.atlassian.net

  // Custom JQL used by the "Sync" button in the tickets drawer to decide
  // which issues get pulled in, instead of the built-in default (see
  // DEFAULT_TICKET_SYNC_JQL in lib/jira.ts). Null means "use the default".
  ticketSyncJql String?

  accounts       Account[]
  sessions       Session[]
  timeEntries    TimeEntry[]
  tickets        Ticket[]
  jiraConnection JiraConnection?
  postIts        PostIt[]
  googleCalendarEvents GoogleCalendarEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App domain models ---

// A user's connected Atlassian account (OAuth 2.0 3LO) — an optional,
// alternate way to connect Jira instead of a manual API token. Only
// available when JIRA_OAUTH_CLIENT_ID/SECRET are configured and the user
// opts into it via the toggle in Settings. Used to call the Jira Cloud REST
// API on their behalf via api.atlassian.com/ex/jira/{cloudId}. Tokens are
// encrypted at rest (AES-256-GCM, see lib/crypto.ts) and are never sent to
// the browser. The user can revoke access anytime from their Atlassian
// account, which invalidates these tokens independent of us.
model JiraConnection {
  id                 String   @id @default(cuid())
  userId             String   @unique
  cloudId            String // Jira Cloud site id (resolved via accessible-resources)
  siteUrl            String // e.g. https://yourcompany.atlassian.net (for browse links)
  accessTokenCipher  String
  refreshTokenCipher String
  expiresAt          DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Local cache of Jira tickets assigned to the user (refreshed periodically)
model Ticket {
  id        String   @id @default(cuid())
  userId    String
  jiraId    String // Jira internal issue id
  key       String // e.g. "PROJ-123"
  summary   String
  status    String // Jira status name, e.g. "In Progress"
  color     String? // UI color assigned for calendar display
  // Whether this ticket is shown in the sidebar's tracked ticket list.
  // False for tickets added ad-hoc via the "search by key" box in the
  // event editor, which should only be attached to that one time entry
  // rather than permanently tracked (promoted to true if it later shows
  // up in a real "assigned to me" sync).
  tracked   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@unique([userId, jiraId])
}

// A calendar time entry created by the user, optionally synced to Jira as a worklog
model TimeEntry {
  id       String   @id @default(cuid())
  userId   String
  ticketId String? // null until a ticket is assigned ("blank" entry created by clicking/dragging on the calendar)
  start    DateTime
  end      DateTime
  // User-entered display title, only used for entries with no ticket
  // assigned (ticketed entries are titled from the ticket key instead).
  title    String?
  // Free-text note sent as the Jira worklog comment when synced.
  comment  String?

  syncedToJira  Boolean   @default(false)
  jiraWorklogId String?
  lastSyncError String?
  lastSyncedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([userId, start])
}

// Local cache of the user's primary Google Calendar events (read-only
// overlay on the app's calendar, see lib/googleCalendar.ts). Refreshed via
// a background sync on page load rather than fetched live from Google on
// every request. Only stores the fields the calendar UI actually renders
// (title/time range/all-day flag/link) — no attendees, description, etc.
model GoogleCalendarEvent {
  id            String   @id @default(cuid())
  userId        String
  googleEventId String // Google's event id, unique per user's calendar
  title         String
  start         DateTime
  end           DateTime
  allDay        Boolean  @default(false)
  htmlLink      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, googleEventId])
  @@index([userId, start])
}

// A port marker annotated on the Map page. Shared across all users (not
// per-user) since it represents a real-world fixed location, but editable
// (name/description/position) and draggable from the map UI.
model MapPort {
  id          String   @id @default(cuid())
  name        String
  code        String   @default("")
  country     String
  description String   @default("")
  // Tenant/operator tag for this port, e.g. "Stena Line" to mark it as run
  // by that ferry operator. Empty string means unset/not applicable.
  tenant      String   @default("")
  lat         Float
  lng         Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Routes that start/end at this port. Dragging the port moves any
  // connected route's endpoint with it, and deleting the port removes
  // routes anchored to it (a route can't dangle unconnected from a port).
  routesAsStart MapRoute[] @relation("RouteStart")
  routesAsEnd   MapRoute[] @relation("RouteEnd")

  // Feature flags tagged on this port (e.g. "tos", "gos", "booking") — a
  // plain many-to-one relation (each row is one item/flag assignment,
  // rather than a shared many-to-many flag entity).
  featureFlags MapPortFeatureFlag[]
}

// A truck depot marker annotated on the Map page. Same shape/semantics as
// MapPort, kept as a separate model so the two marker kinds can be styled
// and queried independently.
model MapDepot {
  id          String   @id @default(cuid())
  name        String
  // Short site/branch code, e.g. "DEDTM" — mirrors MapPort.code. Empty
  // string means unset/not applicable.
  code        String   @default("")
  country     String
  description String   @default("")
  // Tenant/operator tag for this depot, e.g. "KN" (Kuehne+Nagel). Empty
  // string means unset/not applicable. Mirrors MapPort.tenant.
  tenant      String   @default("")
  lat         Float
  lng         Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Feature flags tagged on this depot — see MapPort.featureFlags.
  featureFlags MapDepotFeatureFlag[]
}

// A sea route drawn on the Map page as a cubic bezier curve. Its endpoints
// are always an actual port (`startPort`/`endPort`) rather than a free
// [lat, lng] — this keeps every route visibly connected to a real
// location, and means moving a port automatically drags any routes
// attached to it along with it. `control1`/`control2` are the two bezier
// control points that shape the curve in between (e.g. bowing it around
// land) and remain freely draggable.
model MapRoute {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  startPortId String
  endPortId   String
  control1Lat Float
  control1Lng Float
  control2Lat Float
  control2Lng Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  startPort MapPort @relation("RouteStart", fields: [startPortId], references: [id], onDelete: Cascade)
  endPort   MapPort @relation("RouteEnd", fields: [endPortId], references: [id], onDelete: Cascade)

  // Feature flags tagged on this route — see MapPort.featureFlags.
  featureFlags MapRouteFeatureFlag[]
}

// A single feature-flag tag (e.g. "tos", "gos", "booking") assigned to one
// port. Modeled as a plain many-to-one relation — one row per assignment,
// each pointing at exactly one MapPort — rather than a shared many-to-many
// flag entity, since flag names here are just plain strings rather than
// records with their own identity/metadata worth sharing across items.
model MapPortFeatureFlag {
  id        String   @id @default(cuid())
  name      String
  mapPortId String
  createdAt DateTime @default(now())

  mapPort MapPort @relation(fields: [mapPortId], references: [id], onDelete: Cascade)

  @@unique([mapPortId, name])
}

// Same shape as MapPortFeatureFlag, but for depots.
model MapDepotFeatureFlag {
  id         String   @id @default(cuid())
  name       String
  mapDepotId String
  createdAt  DateTime @default(now())

  mapDepot MapDepot @relation(fields: [mapDepotId], references: [id], onDelete: Cascade)

  @@unique([mapDepotId, name])
}

// Same shape as MapPortFeatureFlag, but for routes.
model MapRouteFeatureFlag {
  id         String   @id @default(cuid())
  name       String
  mapRouteId String
  createdAt  DateTime @default(now())

  mapRoute MapRoute @relation(fields: [mapRouteId], references: [id], onDelete: Cascade)

  @@unique([mapRouteId, name])
}

// A single sticky note on a user's personal post-it board (free-form
// brainstorming/notes board, separate from the calendar/tickets).
model PostIt {
  id       String @id @default(cuid())
  userId   String
  text     String @default("")
  color    String @default("yellow") // one of the palette keys in lib/postits.ts
  x        Float  @default(40) // px offset within the board's scrollable canvas
  y        Float  @default(40)
  rotation Float  @default(0) // slight tilt in degrees, for a hand-placed look
  zIndex   Int    @default(1) // raised on interaction so it sits above others

  // Soft-delete marker: set when a note with actual (non-whitespace)
  // content is removed from the board, so it can be recovered from the
  // trash view instead of being lost immediately. Blank notes, and notes
  // deleted a second time while already in the trash, are removed for
  // good (see the DELETE route) rather than ever getting this set.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
