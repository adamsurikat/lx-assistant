generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- NextAuth required models (Prisma adapter) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Jira integration fields
  jiraEmail          String? // Atlassian account email used for API auth
  jiraApiTokenCipher String? // Encrypted Jira API token (AES-256-GCM, see lib/crypto.ts)
  jiraCloudId        String? // Jira Cloud site id (resolved via accessible-resources)
  jiraSiteUrl        String? // e.g. https://yourcompany.atlassian.net

  accounts    Account[]
  sessions    Session[]
  timeEntries TimeEntry[]
  tickets     Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App domain models ---

// Local cache of Jira tickets assigned to the user (refreshed periodically)
model Ticket {
  id        String   @id @default(cuid())
  userId    String
  jiraId    String // Jira internal issue id
  key       String // e.g. "PROJ-123"
  summary   String
  status    String // Jira status name, e.g. "In Progress"
  color     String? // UI color assigned for calendar display
  // Whether this ticket is shown in the sidebar's tracked ticket list.
  // False for tickets added ad-hoc via the "search by key" box in the
  // event editor, which should only be attached to that one time entry
  // rather than permanently tracked (promoted to true if it later shows
  // up in a real "assigned to me" sync).
  tracked   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@unique([userId, jiraId])
}

// A calendar time entry created by the user, optionally synced to Jira as a worklog
model TimeEntry {
  id       String   @id @default(cuid())
  userId   String
  ticketId String? // null until a ticket is assigned ("blank" entry created by clicking/dragging on the calendar)
  start    DateTime
  end      DateTime
  // User-entered display title, only used for entries with no ticket
  // assigned (ticketed entries are titled from the ticket key instead).
  title    String?
  // Free-text note sent as the Jira worklog comment when synced.
  comment  String?

  syncedToJira  Boolean   @default(false)
  jiraWorklogId String?
  lastSyncError String?
  lastSyncedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([userId, start])
}

// A port marker annotated on the Map page. Shared across all users (not
// per-user) since it represents a real-world fixed location, but editable
// (name/description/position) and draggable from the map UI.
model MapPort {
  id          String   @id @default(cuid())
  name        String
  code        String   @default("")
  country     String
  description String   @default("")
  // Tenant/operator tag for this port, e.g. "Stena Line" to mark it as run
  // by that ferry operator. Empty string means unset/not applicable.
  tenant      String   @default("")
  lat         Float
  lng         Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Routes that start/end at this port. Dragging the port moves any
  // connected route's endpoint with it, and deleting the port removes
  // routes anchored to it (a route can't dangle unconnected from a port).
  routesAsStart MapRoute[] @relation("RouteStart")
  routesAsEnd   MapRoute[] @relation("RouteEnd")
}

// A truck depot marker annotated on the Map page. Same shape/semantics as
// MapPort, kept as a separate model so the two marker kinds can be styled
// and queried independently.
model MapDepot {
  id          String   @id @default(cuid())
  name        String
  // Short site/branch code, e.g. "DEDTM" — mirrors MapPort.code. Empty
  // string means unset/not applicable.
  code        String   @default("")
  country     String
  description String   @default("")
  // Tenant/operator tag for this depot, e.g. "KN" (Kuehne+Nagel). Empty
  // string means unset/not applicable. Mirrors MapPort.tenant.
  tenant      String   @default("")
  lat         Float
  lng         Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A sea route drawn on the Map page as a cubic bezier curve. Its endpoints
// are always an actual port (`startPort`/`endPort`) rather than a free
// [lat, lng] — this keeps every route visibly connected to a real
// location, and means moving a port automatically drags any routes
// attached to it along with it. `control1`/`control2` are the two bezier
// control points that shape the curve in between (e.g. bowing it around
// land) and remain freely draggable.
model MapRoute {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  startPortId String
  endPortId   String
  control1Lat Float
  control1Lng Float
  control2Lat Float
  control2Lng Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  startPort MapPort @relation("RouteStart", fields: [startPortId], references: [id], onDelete: Cascade)
  endPort   MapPort @relation("RouteEnd", fields: [endPortId], references: [id], onDelete: Cascade)
}
